# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Your own Clerk User ID — only this account can access /admin
ADMIN_CLERK_USER_ID=

# Neon (Postgres connection string, from the Neon dashboard)
DATABASE_URL=

# The project ID (from Neon) whose media powers the public homepage —
# see ADMIN-SETUP.md, "Connecting the public portfolio"
PUBLIC_PORTFOLIO_PROJECT_ID=

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (contact form email notifications)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=

# Cal.com (booking) — e.g. "olivialaine/consultation"
NEXT_PUBLIC_CAL_LINK=
